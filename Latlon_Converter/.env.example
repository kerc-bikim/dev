# 브이월드 오픈API 인증키 (https://www.vworld.kr 오픈API > 인증키 발급)
# 활용 API에서 "검색 API", "2D데이터 API", "국가중점데이터 API"를 모두 체크해야 합니다.
VWORLD_API_KEY=

# 인증키 발급 시 등록한 서비스 URL과 반드시 동일해야 합니다.
# 2D데이터/국가중점 API는 이 값이 다르면 INCORRECT_KEY 오류가 납니다.
VWORLD_DOMAIN=http://localhost

# vworld | mock  (기본값 mock — 키 없이 동작)
LATLON_PROVIDER=mock

# 사내망 TLS 검사 장비를 거쳐 CERTIFICATE_VERIFY_FAILED가 날 때 쓸 인증서 경로.
# 발급받은 인증서(예: test.crt)를 PEM 형식으로 두고 경로를 적습니다.
# 비워 두면 시스템 기본 신뢰 저장소를 씁니다.
# 설정 확인: python -m latlon_converter check
LATLON_CA_BUNDLE=

# 응답 캐시 sqlite 경로 (비우면 캐시 사용 안 함)
LATLON_CACHE_DB=Latlon_Converter/cache.sqlite

# 캐시 유효기간(일)
LATLON_CACHE_TTL_DAYS=30

# HTTP 타임아웃(초)와 재시도 횟수
LATLON_TIMEOUT=10
LATLON_RETRIES=3
