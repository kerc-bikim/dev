# Latlon_Converter 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋하지 마세요.
#
#   copy .env.example .env
#
# 설정 확인:  python -m latlon_converter check

# ---------------------------------------------------------------------------
# 브이월드 오픈API (실제 조회 시 필수)
# https://www.vworld.kr  →  오픈API > 인증키 발급
# 활용 API에서 아래 세 가지를 모두 체크해야 합니다.
#   - 검색 API            좌표→주소 폴백, search 명령
#   - 2D데이터 API        연속지적도 (필지·PNU·공시지가)
#   - 국가중점데이터 API  토지임야정보, 토지소유정보, 토지특성정보
# ---------------------------------------------------------------------------
VWORLD_API_KEY=

# 인증키 발급 시 등록한 서비스 URL과 반드시 같아야 합니다.
# 2D데이터·국가중점 API는 이 값이 다르면 INCORRECT_KEY 가 납니다.
VWORLD_DOMAIN=http://localhost

# 조회 제공자. mock = 키 없이 샘플/합성, vworld = 실제 API
# 명령줄 --provider 가 이 값보다 우선합니다.
LATLON_PROVIDER=mock

# ---------------------------------------------------------------------------
# 사내망 TLS (CERTIFICATE_VERIFY_FAILED 가 날 때만)
# PEM 형식 인증서 경로. DER(.crt 바이너리)이면 먼저 변환하세요.
#   openssl x509 -inform der -in test.crt -out test.pem
# 상대경로는 실행 위치, 없으면 이 프로젝트 폴더에서 찾습니다.
# REQUESTS_CA_BUNDLE 도 인식하지만, 둘 다 있으면 LATLON_CA_BUNDLE 이 우선합니다.
# ---------------------------------------------------------------------------
LATLON_CA_BUNDLE=

# 응답 캐시 sqlite. 비우면 캐시하지 않습니다.
# 일괄 재실행 때 브이월드 일일 한도를 아끼려면 경로를 넣으세요.
LATLON_CACHE_DB=cache.sqlite

# 캐시 유효기간(일)
LATLON_CACHE_TTL_DAYS=30

# HTTP 타임아웃(초)과 재시도 횟수
LATLON_TIMEOUT=10
LATLON_RETRIES=3
