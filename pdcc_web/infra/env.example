# 개발 기본값. 프로덕션은 APP_SECRET / POSTGRES_PASSWORD 를 반드시 바꾸고
# APP_ENV=production, ALLOW_STUB_LOGIN=false 로 둔다. 자세한 내용: infra/runbook.md

APP_ENV=development
APP_SECRET=dev-insecure-change-me
DATABASE_URL=postgresql+psycopg://pdcc:pdcc@postgres:5432/pdcc
REDIS_URL=redis://redis:6379/0
DEV_BOOTSTRAP_ADMIN=false
ALLOW_STUB_LOGIN=true
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=
AUDIT_RETENTION_DAYS=365
NRL_BASE_URL=https://service.earthscope.org/irisws/nrl/1
NRL_TIMEOUT_SEC=30
NRL_CACHE_TTL_SEC=3600
POSTGRES_USER=pdcc
POSTGRES_PASSWORD=pdcc
POSTGRES_DB=pdcc
