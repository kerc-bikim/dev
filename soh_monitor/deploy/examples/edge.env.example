# 지역 Edge Collector 환경 설정 예시.
#
#   cp deploy/examples/edge.env.example edge.env
#   docker compose -f deploy/compose/compose.edge.yml --env-file edge.env up -d
#
# Edge 는 관측소 목록을 알지 못한 채 시작한다. 어느 기록계를 수집할지는 중앙에서
# 설정으로 내려온다. 그래서 이 파일에는 기록계 IP 가 없다.

SOH_APP_ENV=production
SOH_LOG_LEVEL=INFO

SOH_IMAGE_EDGE=soh-edge:latest

# 중앙에서 Edge 를 만들면 발급되는 식별자
SOH_EDGE_ID=edge-region-a-01

# 중앙 주소. 443 Outbound 만 사용한다.
SOH_CENTRAL_URL=https://monitoring.example.org

# 로컬 Spool. 중앙이 끊긴 동안 여기에 쌓인다.
SOH_EDGE_SPOOL_LIMIT_BYTES=5368709120
SOH_EDGE_HEARTBEAT_SECONDS=30
SOH_EDGE_UPLOAD_TIMEOUT_SECONDS=30

# 지역 회선 사정에 맞춘 동시 수집 수
SOH_MAX_CONCURRENT_POLLS=10

# 중앙에서 Edge 를 만들면 한 번만 보이는 등록 Token. 등록이 끝나면 이 값을 지운다.
SOH_EDGE_ENROLLMENT_TOKEN=

SOH_SECRET_DIR=./secrets

# 필요한 파일
#   secrets/device_credential_key   기록계 인증정보 복호화 키
# 등록이 끝나면 인증서와 클라이언트 토큰은 Spool 볼륨(/var/lib/soh-edge/certs)에 저장된다.
