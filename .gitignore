# Shared Python virtualenv created by .cursor/install.sh.
# Ignored so Cloud Agent branch checkouts preserve it (like node_modules) and
# it is never accidentally committed.
.venv/

# Python bytecode caches
__pycache__/
*.pyc

# PPSD backend runtime output (recreated at runtime)
PPSD_v1/backend/cache/
PPSD_v1/backend/sds/

# Earthworm web control
earthworm_web/frontend/node_modules/
earthworm_web/frontend/dist/
earthworm_web/.ew_home/
earthworm_web/backend/data/app.json
earthworm_web/backend/.env

# PDCC web
pdcc_web/.env
pdcc_web/apps/web/node_modules/
pdcc_web/apps/web/dist/
pdcc_web/apps/api/.pytest_cache/
pdcc_web/apps/api/.venv/
pdcc_web/certs/*.crt
pdcc_web/certs/*.pem
pdcc_web/certs/*.cer
pdcc_web/certs/*.key


# redis dumps
*.rdb
